{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Principals","direction":8,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["Buffy Summers. Sophomore, late of Hemery High in Los Angeles."]},{"code":401,"indent":0,"parameters":["Interesting record. Quite a career."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["A  clean slate, Buffy, that’s what you get here. What’s past"]},{"code":401,"indent":0,"parameters":["is past. We’re not interested in what it says on a piece of"]},{"code":401,"indent":0,"parameters":["paper. Even if it says... whoah."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Buffy"]},{"code":401,"indent":0,"parameters":["Mr Flutie..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["All the kids here are free to call me Bob."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Buffy"]},{"code":401,"indent":0,"parameters":["Bob..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["But they don’t."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Buffy"]},{"code":401,"indent":0,"parameters":["Mr Flutie. I know my transcripts are a little colourful..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["Hey, we’re not caring about that! Do you think ‘colourful’"]},{"code":401,"indent":0,"parameters":["is the word? Not ‘dismal’?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Buffy"]},{"code":401,"indent":0,"parameters":["It wasn’t that bad."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["You burned down the gym."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Buffy"]},{"code":401,"indent":0,"parameters":["I did. I really did. But you’re not seeing the big picture."]},{"code":401,"indent":0,"parameters":["I mean the gym was full of vamp- uh, asbestos."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Principal Flutie"]},{"code":401,"indent":0,"parameters":["Buffy. Don’t worry. Any other school, they might say ‘watch your step’,"]},{"code":401,"indent":0,"parameters":["or ‘we’ll be watching you’, but that’s just not the way here."]},{"code":401,"indent":0,"parameters":["We want to service your needs, and help you to respect our needs."]},{"code":401,"indent":0,"parameters":["And if your needs and our needs don’t mesh..."]},{"code":223,"indent":0,"parameters":[[-255,-255,-255,0],8,true]},{"code":320,"indent":0,"parameters":[4,"> Got your schedule"]},{"code":320,"indent":0,"parameters":[5,""]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["+1 Knowledge"]},{"code":201,"indent":0,"parameters":[0,5,17,21,8,0]},{"code":126,"indent":0,"parameters":[11,0,0,1]},{"code":223,"indent":0,"parameters":[[0,0,0,0],8,true]},{"code":122,"indent":0,"parameters":[17,17,1,0,1]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":8,"y":8}
